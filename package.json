{
  "name": "flume",
  "version": "1.2.0",
  "description": "A node editor for React",
  "author": "chrisjpatty",
  "license": "MIT",
  "homepage": "https://flume.dev",
  "repository": "chrisjpatty/flume",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "jsnext:main": "./dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "engines": {
    "node": ">=8",
    "npm": ">=5"
  },
  "scripts": {
    "test": "vitest && npx cypress run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "build": "pnpm run build:types && pnpm run build:vite",
    "build:types": "tsgo -p tsconfig.build.json",
    "build:vite": "vite build",
    "start": "vite build --watch",
    "release": "changeset publish",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "peerDependencies": {
    "prop-types": "^15.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/cli": "^3.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/d3-shape": "^3.1.8",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-portal": "^4.0.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.0",
    "gh-pages": "^6.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-puppeteer": "^11.0.0",
    "postcss-nested": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "text-encoding": "^0.7.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0",
    "wait-on": "^9.1.0",
    "y18n": "^5.0.8"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@reach/auto-id": "^0.18.0",
    "d3-shape": "^3.2.0",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.1",
    "react-portal": "^4.3.0"
  }
}