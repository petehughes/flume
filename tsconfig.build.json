{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": ["dist", "src/tests"],
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "src/*.d.ts"]
}
